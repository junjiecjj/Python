% 2025 TCOM
% "Sensing Mutual Information With Random Signals in Gaussian Channels"
% Fig.14: Sensing and Communication tradeoff under different precoding schemes
%
% 两条曲线：
%   1) SMI-oriented Precoding Design
%      - sensing objective: asymptotic SMI in Eq.(11)-(13)
%      - ISAC optimization: Eq.(55)-(61), ADMM
%
%   2) UB-SMI-oriented Precoding Design
%      - sensing objective: SMI upper bound in Eq.(10)
%      - communication constraint / ADMM framework保持一致
%
% 论文明确参数：
%   fc = 28 GHz
%   NT = NR = 16
%   NC = 4
%   ND = 4
%   K = KT = KR = 4
%   communication-user distance = 20 m
%   target dT,k,dR,k ~ U[25,35] m
%   AOD/AOA ~ U[30,60] degree
%   a = 61.4, b = 2, sigma_epsilon = 5.8 dB
%   P = 40 dBm
%   noise power = -90 dBm
%   rho = 1e4
%   beta_m = 1.5e-4
%
% Fig.14 没有重新给 NS；紧邻的 Fig.11/12 使用 K=ND=NS=4，
% 因此本复现取 NS=4。若作者原始代码采用不同 NS，只需修改下面一行。
%
% 论文没有公开：
%   1) target / communication channel 的随机 realization 和 seed；
%   2) Rc 的具体 realization；
%   3) Fig.14 每个 R0 的精确取值。
%
% 为使横轴覆盖原图约 [16,26] bps/Hz，本代码提供一个显式开关
% calibrateCommunicationChannel=true，把当前 Hc realization 的最大通信速率
% 缩放到约 26.5 bps/Hz。这个缩放只是弥补“原文未公开具体 Hc realization”，
% 并没有改变 Fig.14 的优化算法。若希望完全按生成的物理信道运行，将其设为 false。
%
% CVX:
%   你的 Ubuntu/MATLAB 环境建议提前设置 SeDuMi 为默认 solver：
%       cvx_solver sedumi
%       cvx_save_prefs
%   本脚本不再主动切换 solver，避免 CVX 模型异常退出后残留状态导致报错。
%
% 主程序不封装，便于逐段调试。

clear all; clc; close all;
rng(3);

%% CVX vec 路径修复（MATLAB R2024b + CVX）
cvxRoot = fileparts(which('cvx_setup'));
vecPath = fullfile(cvxRoot,'functions','vec_');

if exist(vecPath,'dir')
    addpath(vecPath,'-begin');
    clear vec;
    rehash path;
end

cvx_clear;

%% 系统参数
c0 = 3e8;
fc = 28e9;
lambda = c0/fc;
dAnt = lambda/2;

NT = 16;
NR = 16;
NC = 4;
ND = 4;
NS = 4;

K = 4;
KT = K;
KR = K;

aPL = 61.4;
bPL = 2;
sigmaShadow = 5.8;

P_dBm = 40;
P = 10^((P_dBm-30)/10);                  % W

noise_dBm = -90;
sigma2_s = 10^((noise_dBm-30)/10);       % sensing noise power, W
sigma2_c = 10^((noise_dBm-30)/10);       % communication noise power, W

rhoPenalty = 1e4;
betaADMM = 1.5e-4;
admmMaxIter = 80;
admmTol = 1e-5;

R0Set = 16:1:26;

calibrateCommunicationChannel = true;
targetRmax = 26.5;

%% ========================================================================
%  构造 sensing correlation matrices R_T 和 R_R
% ========================================================================

% 目标 Tx/Rx 距离与角度
dT = 25+10*rand(K,1);
dR = 25+10*rand(K,1);

AOD = 30+30*rand(K,1);
AOA = 30+30*rand(K,1);

% 论文给出 path gain variance: 10^(-0.1*kappa(d))
% 对 bistatic 路径，这里使用总传播距离 dT+dR。
shadow = sigmaShadow*randn(K,1);
dPath = dT+dR;
kappaTarget = aPL+10*bPL*log10(dPath)+shadow;
pathPowerTarget = 10.^(-0.1*kappaTarget);

AT = complex(zeros(NT,K));
AR = complex(zeros(NR,K));

for k = 1:K
    AT(:,k) = steeringVector(NT,AOD(k));
    AR(:,k) = steeringVector(NR,AOA(k));
end

% Eq.(6)采用 separable covariance H_s=R_R^(1/2)*Sigma*R_T^(1/2)。
% 为使 R_R \otimes R_T 的总体 path-loss 数量级与单个 bistatic path gain 一致，
% 将 sqrt(pathPower) 分配到 Tx/Rx 两侧 correlation matrices。
RT = complex(zeros(NT,NT));
RR = complex(zeros(NR,NR));

for k = 1:K
    weight = sqrt(pathPowerTarget(k));
    RT = RT+weight*(AT(:,k)*AT(:,k)');
    RR = RR+weight*(AR(:,k)*AR(:,k)');
end

RT = (RT+RT')/2;
RR = (RR+RR')/2;

RTsqrt = matrixSqrtPSD(RT);

fprintf('============================================================\n');
fprintf('Fig.14 reproduction\n');
fprintf('NT=%d, NR=%d, NC=%d, ND=%d, NS=%d, K=%d\n',NT,NR,NC,ND,NS,K);
fprintf('P=%.1f dBm, noise=%.1f dBm, rho=%.1e, beta=%.2e\n',P_dBm,noise_dBm,rhoPenalty,betaADMM);
fprintf('Target distances dT+dR [m]: ');
fprintf('%.3f  ',dPath);
fprintf('\n');

%% ========================================================================
%  构造 communication channel H_c
% ========================================================================

dC = 20;
shadowC = sigmaShadow*randn;
kappaC = aPL+10*bPL*log10(dC)+shadowC;
pathPowerC = 10^(-0.1*kappaC);

% 使用 R_T 的归一化版本作为 transmitter-side spatial correlation。
RTcorr = RT/(real(trace(RT))/NT);
RTcorr = (RTcorr+RTcorr')/2;

Gc = (randn(NC,NT)+1j*randn(NC,NT))/sqrt(2*NT);
Hc = sqrt(pathPowerC)*Gc*matrixSqrtPSD(RTcorr);

% 论文没有公开 Fig.14 的具体 H_c realization。
% 可选：只通过一个整体标量校准，使 communication-only Rmax 对齐原图右端约 26 bps/Hz。
if calibrateCommunicationChannel
    scaleLeft = 1e-3;
    scaleRight = 1e3;

    for ib = 1:80
        scaleMid = sqrt(scaleLeft*scaleRight);
        [~,Rmid] = communicationWaterFilling(Hc*scaleMid,P,NS,sigma2_c);

        if Rmid < targetRmax
            scaleLeft = scaleMid;
        else
            scaleRight = scaleMid;
        end
    end

    channelScale = sqrt(scaleLeft*scaleRight);
    Hc = channelScale*Hc;
else
    channelScale = 1;
end

[OmegaComm,Rmax] = communicationWaterFilling(Hc,P,NS,sigma2_c);

fprintf('Communication channel scale = %.6e\n',channelScale);
fprintf('Communication-only Rmax = %.6f bps/Hz\n',Rmax);
fprintf('R0 = ');
fprintf('%.2f  ',R0Set);
fprintf('\n============================================================\n');

if max(R0Set) > Rmax
    warning('R0Set 中存在超过通信最大速率 Rmax 的点，这些点将不可行。');
end

%% ========================================================================
%  先求两个 sensing-only 初始点
% ========================================================================

Phi0 = P/NT*eye(NT);

PhiSensing = Phi0;
for m = 1:40
    [~,gradSMI] = sensingSMIAndGradient(PhiSensing,RTsqrt,RR,sigma2_s,NS);
    PhiSensing = projectPSDTrace(PhiSensing+1e-3*gradSMI,P);
end

PhiUB = Phi0;
for m = 1:40
    gradUB = upperBoundGradient(PhiUB,RTsqrt,RR,sigma2_s);
    PhiUB = projectPSDTrace(PhiUB+1e-3*gradUB,P);
end

fprintf('Sensing-only initialization:\n');
fprintf('  SMI-oriented SMI = %.6f bits/CPI\n',sensingSMI(PhiSensing,RTsqrt,RR,sigma2_s,NS));
fprintf('  UB-oriented  SMI = %.6f bits/CPI\n\n',sensingSMI(PhiUB,RTsqrt,RR,sigma2_s,NS));

%% ========================================================================
%  Fig.14 曲线 1：SMI-oriented Precoding Design
% ========================================================================

rateSMI = nan(size(R0Set));
sensingSMIResult = nan(size(R0Set));

PhiPrev = PhiSensing;
OmegaPrev = OmegaComm;

for iR = 1:length(R0Set)

    R0 = R0Set(iR);

    if R0 > Rmax
        continue;
    end

    fprintf('\n------------------------------------------------------------\n');
    fprintf('SMI-oriented: R0 = %.2f bps/Hz\n',R0);
    fprintf('------------------------------------------------------------\n');

    Phi = PhiPrev;
    Omega = OmegaPrev;
    Delta = zeros(NT);

    for m = 1:admmMaxIter

        % ---------------------------------------------------------------
        % Eq.(58a): update Phi
        % L_s(Phi)=-I_s(Phi)
        % Eq.(50),(52) give grad L_s = -grad I_s.
        % Eq.(57) 的 quadratic penalty 的梯度为 rho*(Phi-Omega+Delta).
        % ---------------------------------------------------------------
        [~,gradIs] = sensingSMIAndGradient(Phi,RTsqrt,RR,sigma2_s,NS);
        gradPhi = -gradIs+rhoPenalty*(Phi-Omega+Delta);

        PhiNew = Phi-betaADMM*gradPhi;
        PhiNew = projectPSDTrace(PhiNew,P);

        % ---------------------------------------------------------------
        % Eq.(58b)/(61): update Omega by CVX
        % min ||PhiNew-Omega+Delta||_F
        % s.t. Ic(Omega)>=R0, tr(Omega)<=P, Omega>=0.
        %
        % log2 det(A)>=R0
        % <=> det(A)^(1/NC) >= 2^(R0/NC)
        % 使用 det_rootn 避免 log_det successive approximation.
        % ---------------------------------------------------------------
        B = PhiNew+Delta;

        cvx_begin sdp quiet
            cvx_precision high
            variable OmegaVar(NT,NT) hermitian semidefinite
            expression RateMatrix(NC,NC)

            RateMatrix = eye(NC)+Hc*OmegaVar*Hc'/(NS*sigma2_c);

            minimize(norm(OmegaVar-B,'fro'))

            subject to
                real(trace(OmegaVar)) <= P;
                det_rootn(RateMatrix) >= 2^(R0/NC);
        cvx_end

        if ~contains(cvx_status,'Solved')
            error('SMI-oriented Omega update failed at R0=%.2f. CVX status: %s',R0,cvx_status);
        end

        OmegaNew = (OmegaVar+OmegaVar')/2;

        % Eq.(58c)
        DeltaNew = Delta+PhiNew-OmegaNew;

        primalResidual = norm(PhiNew-OmegaNew,'fro')/max(1,norm(PhiNew,'fro'));
        dualResidual = norm(OmegaNew-Omega,'fro')/max(1,norm(Omega,'fro'));

        Phi = PhiNew;
        Omega = OmegaNew;
        Delta = DeltaNew;

        if mod(m,10)==0 || m==1
            fprintf('Iter=%3d, Is=%.6f, Ic=%.6f, primal=%.3e, dual=%.3e\n', ...
                m,sensingSMI(Phi,RTsqrt,RR,sigma2_s,NS),communicationMI(Phi,Hc,NS,sigma2_c),primalResidual,dualResidual);
        end

        if m >= 10 && primalResidual < admmTol && dualResidual < admmTol
            break;
        end
    end

    rateSMI(iR) = communicationMI(Phi,Hc,NS,sigma2_c);
    sensingSMIResult(iR) = sensingSMI(Phi,RTsqrt,RR,sigma2_s,NS);

    fprintf('Final: Ic=%.6f bps/Hz, Is=%.6f bits/CPI, Iter=%d\n',rateSMI(iR),sensingSMIResult(iR),m);

    PhiPrev = Phi;
    OmegaPrev = Omega;
end

%% ========================================================================
%  Fig.14 曲线 2：UB-SMI-oriented Precoding Design
% ========================================================================

rateUB = nan(size(R0Set));
sensingUBResult = nan(size(R0Set));

PhiPrev = PhiUB;
OmegaPrev = OmegaComm;

for iR = 1:length(R0Set)

    R0 = R0Set(iR);

    if R0 > Rmax
        continue;
    end

    fprintf('\n------------------------------------------------------------\n');
    fprintf('UB-SMI-oriented: R0 = %.2f bps/Hz\n',R0);
    fprintf('------------------------------------------------------------\n');

    Phi = PhiPrev;
    Omega = OmegaPrev;
    Delta = zeros(NT);

    for m = 1:admmMaxIter

        % Upper-bound sensing objective Eq.(10)
        gradIub = upperBoundGradient(Phi,RTsqrt,RR,sigma2_s);
        gradPhi = -gradIub+rhoPenalty*(Phi-Omega+Delta);

        PhiNew = Phi-betaADMM*gradPhi;
        PhiNew = projectPSDTrace(PhiNew,P);

        B = PhiNew+Delta;

        cvx_begin sdp quiet
            cvx_precision high
            variable OmegaVar(NT,NT) hermitian semidefinite
            expression RateMatrix(NC,NC)

            RateMatrix = eye(NC)+Hc*OmegaVar*Hc'/(NS*sigma2_c);

            minimize(norm(OmegaVar-B,'fro'))

            subject to
                real(trace(OmegaVar)) <= P;
                det_rootn(RateMatrix) >= 2^(R0/NC);
        cvx_end

        if ~contains(cvx_status,'Solved')
            error('UB-SMI-oriented Omega update failed at R0=%.2f. CVX status: %s',R0,cvx_status);
        end

        OmegaNew = (OmegaVar+OmegaVar')/2;
        DeltaNew = Delta+PhiNew-OmegaNew;

        primalResidual = norm(PhiNew-OmegaNew,'fro')/max(1,norm(PhiNew,'fro'));
        dualResidual = norm(OmegaNew-Omega,'fro')/max(1,norm(Omega,'fro'));

        Phi = PhiNew;
        Omega = OmegaNew;
        Delta = DeltaNew;

        if mod(m,10)==0 || m==1
            fprintf('Iter=%3d, Is=%.6f, Ic=%.6f, primal=%.3e, dual=%.3e\n', ...
                m,sensingSMI(Phi,RTsqrt,RR,sigma2_s,NS),communicationMI(Phi,Hc,NS,sigma2_c),primalResidual,dualResidual);
        end

        if m >= 10 && primalResidual < admmTol && dualResidual < admmTol
            break;
        end
    end

    rateUB(iR) = communicationMI(Phi,Hc,NS,sigma2_c);

    % Fig.14 的纵轴统一画真实/渐近 SMI，而不是 upper bound 本身
    sensingUBResult(iR) = sensingSMI(Phi,RTsqrt,RR,sigma2_s,NS);

    fprintf('Final: Ic=%.6f bps/Hz, Is=%.6f bits/CPI, Iter=%d\n',rateUB(iR),sensingUBResult(iR),m);

    PhiPrev = Phi;
    OmegaPrev = Omega;
end

%% 打印最终结果
fprintf('\n============================================================\n');
fprintf('Final Fig.14 data\n');
fprintf('============================================================\n');

fprintf('SMI-oriented Rate: ');
fprintf('%.6f  ',rateSMI);
fprintf('\n');

fprintf('SMI-oriented SMI:  ');
fprintf('%.6f  ',sensingSMIResult);
fprintf('\n');

fprintf('UB-oriented Rate:  ');
fprintf('%.6f  ',rateUB);
fprintf('\n');

fprintf('UB-oriented SMI:   ');
fprintf('%.6f  ',sensingUBResult);
fprintf('\n');

%%===========================================

width = 6;
height = 4;
fontsize = 14;
linewidth = 2;
markersize = 8;

set(groot, 'defaultAxesFontName', 'Times New Roman');
set(groot, 'defaultTextFontName', 'Times New Roman');
set(groot, 'defaultLegendFontName', 'Times New Roman');

%%========================================================================================
%         绘制 Fig.14
%%========================================================================================

figure(1);
set(gcf, 'Units', 'inches');
set(gcf, 'Color', 'white');
set(gcf, 'Renderer', 'painters');
set(gcf, 'PaperUnits', 'inches');
set(gcf, 'PaperPosition', [0, 0, width, height]);
set(gcf, 'PaperSize', [width, height]);
set(gcf, 'PaperPositionMode', 'manual');

% 保持原 Fig.14 的线型和 marker：
% SMI-oriented: solid + circle
% UB-SMI-oriented: dashed + plus
p1 = plot(rateSMI,sensingSMIResult,'-','LineWidth',linewidth,'Marker','o','MarkerSize',markersize,'MarkerFaceColor','w'); hold on;
p1.Color = '#00A1F1';

p2 = plot(rateUB,sensingUBResult,'--','LineWidth',linewidth,'Marker','+','MarkerSize',markersize);
p2.Color = '#F65314';

set(gca,'FontSize',16,'FontName','Times New Roman');

h_legend = legend('SMI-oriented Precoding Design','UB-SMI-oriented Precoding Design','Interpreter','latex');
legendsize = 13;
set(h_legend,'FontName','Times New Roman','FontSize',legendsize,'FontWeight','normal','LineWidth',1,'Location','southwest');
h_legend.Color = 'none';

labelsize = 18;
xlabel('Communication Rate [bps/Hz]','FontSize',labelsize,'FontName','Times New Roman');
ylabel('Sensing MI [bits/CPI]','FontSize',labelsize,'FontName','Times New Roman');

% xlim([16 26]);
% ylim([48 63]);
% xticks(16:2:26);
% yticks(48:2:62);

grid on;
set(gca,'GridLineStyle','--','GridAlpha',0.2,'LineWidth',1,'GridLineWidth',0.5,'Layer','bottom');

set(gca,'Units','normalized');
set(gca,'Position',[0.11,0.12,0.87,0.86]);

print(gcf,'Fig14_TCOM_MATLAB.pdf','-dpdf','-vector');

hold off;


%% ========================================================================
% Local functions
% ========================================================================

function a = steeringVector(N,thetaDeg)

    n = (0:N-1).';
    a = exp(1j*pi*n*sind(thetaDeg))/sqrt(N);
end


function Ahalf = matrixSqrtPSD(A)

    A = (A+A')/2;
    [U,D] = eig(A);

    d = real(diag(D));
    d(d<0) = 0;

    Ahalf = U*diag(sqrt(d))*U';
    Ahalf = (Ahalf+Ahalf')/2;
end


function PhiProj = projectPSDTrace(Phi,P)

    Phi = (Phi+Phi')/2;
    [U,D] = eig(Phi);

    d = real(diag(D));
    d(d<0) = 0;

    if sum(d) > P
        d = d*P/sum(d);
    end

    PhiProj = U*diag(d)*U';
    PhiProj = (PhiProj+PhiProj')/2;
end


function [Is,gradIs] = sensingSMIAndGradient(Phi,RTsqrt,RR,sigma2_s,NS)

    NT = size(Phi,1);

    T = RTsqrt*Phi*RTsqrt;
    T = (T+T')/2;

    lambdaR = real(eig((RR+RR')/(2*sigma2_s)));
    lambdaR = sort(lambdaR,'descend');

    if max(lambdaR) > 0
        lambdaR = lambdaR(lambdaR > 1e-10*max(lambdaR));
    else
        lambdaR = [];
    end

    Is = 0;
    gradIs = complex(zeros(NT,NT));

    for j = 1:length(lambdaR)

        rho = lambdaR(j);

        % Eq.(13): fixed-point equation for delta(rho)
        delta = max(real(trace(T))/NS,1e-30);

        for it = 1:1000
            alpha = rho/(1+rho*delta);
            M = (eye(NT)+alpha*T)\eye(NT);
            deltaNew = real(trace(T*M))/NS;

            if abs(deltaNew-delta) <= 1e-12*max(1,abs(delta))
                delta = deltaNew;
                break;
            end

            delta = 0.5*delta+0.5*deltaNew;
        end

        alpha = rho/(1+rho*delta);
        M = (eye(NT)+alpha*T)\eye(NT);
        M = (M+M')/2;

        % Eq.(12)
        term1 = log2detHermitian(eye(NT)+alpha*T);
        term2 = NS*log2(1+rho*delta);
        term3 = NS*rho*delta/(1+rho*delta);

        Is = Is+term1+term2-term3;

        % Eq.(50)
        gradIs = gradIs+alpha*RTsqrt*M*RTsqrt;
    end

    gradIs = (gradIs+gradIs')/2;
end


function Is = sensingSMI(Phi,RTsqrt,RR,sigma2_s,NS)

    [Is,~] = sensingSMIAndGradient(Phi,RTsqrt,RR,sigma2_s,NS);
end


function Iub = sensingUpperBound(Phi,RTsqrt,RR,sigma2_s)

    NT = size(Phi,1);

    T = RTsqrt*Phi*RTsqrt;
    T = (T+T')/2;

    lambdaR = real(eig((RR+RR')/(2*sigma2_s)));
    lambdaR = sort(lambdaR,'descend');

    if max(lambdaR) > 0
        lambdaR = lambdaR(lambdaR > 1e-10*max(lambdaR));
    else
        lambdaR = [];
    end

    Iub = 0;

    for j = 1:length(lambdaR)
        Iub = Iub+log2detHermitian(eye(NT)+lambdaR(j)*T);
    end
end


function gradIub = upperBoundGradient(Phi,RTsqrt,RR,sigma2_s)

    NT = size(Phi,1);

    T = RTsqrt*Phi*RTsqrt;
    T = (T+T')/2;

    lambdaR = real(eig((RR+RR')/(2*sigma2_s)));
    lambdaR = sort(lambdaR,'descend');

    if max(lambdaR) > 0
        lambdaR = lambdaR(lambdaR > 1e-10*max(lambdaR));
    else
        lambdaR = [];
    end

    gradIub = complex(zeros(NT,NT));

    for j = 1:length(lambdaR)

        rho = lambdaR(j);
        M = (eye(NT)+rho*T)\eye(NT);

        % d log2 det(A) = tr(A^{-1}dA)/ln(2)
        gradIub = gradIub+rho/log(2)*RTsqrt*M*RTsqrt;
    end

    gradIub = (gradIub+gradIub')/2;
end


function Ic = communicationMI(Phi,Hc,NS,sigma2_c)

    NC = size(Hc,1);

    A = eye(NC)+Hc*Phi*Hc'/(NS*sigma2_c);
    A = (A+A')/2;

    Ic = log2detHermitian(A);
end


function [Omega,Rmax] = communicationWaterFilling(Hc,P,NS,sigma2_c)

    [~,S,V] = svd(Hc,'econ');

    singularValue = diag(S);
    gain = singularValue.^2/(NS*sigma2_c);

    activeGain = gain > 1e-15*max(gain);

    muLeft = 0;
    muRight = 1;

    while sum(max(muRight-1./gain(activeGain),0)) < P
        muRight = 2*muRight;
    end

    for k = 1:100

        mu = (muLeft+muRight)/2;
        pActive = max(mu-1./gain(activeGain),0);

        if sum(pActive) < P
            muLeft = mu;
        else
            muRight = mu;
        end
    end

    mu = (muLeft+muRight)/2;

    p = zeros(length(gain),1);
    p(activeGain) = max(mu-1./gain(activeGain),0);

    Omega = V*diag(p)*V';
    Omega = (Omega+Omega')/2;

    Rmax = sum(log2(1+gain.*p));
end


function value = log2detHermitian(A)

    A = (A+A')/2;
    d = real(eig(A));

    d(d<eps) = eps;

    value = sum(log2(d));
end
